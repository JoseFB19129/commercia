# Copia este archivo como .env y completa tus datos

# En Windows evita mongodb+srv:// (error querySrv ECONNREFUSED)
# 1. En Atlas: Connect > Drivers > copia la cadena "standard"
# 2. Ejecuta: node scripts/find-primary.js  (encuentra el nodo PRIMARY)
# 3. Pega aquí la URI con directConnection=true apuntando al PRIMARY

MONGODB_URI=mongodb://USUARIO:CONTRASENA@ac-xxxxx-shard-00-01.xxxxx.mongodb.net:27017/commercia?ssl=true&authSource=admin&directConnection=true

JWT_SECRET=tu_clave_secreta_jwt
PORT=3000
